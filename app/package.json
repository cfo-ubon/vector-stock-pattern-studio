{
  "name": "app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop:build:renderer": "vite build --config vite.config.desktop.ts",
    "desktop:build:main": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "desktop:build": "npm run desktop:build:renderer && npm run desktop:build:main",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:installer": "npm run desktop:build && electron-builder --win nsis --x64",
    "desktop:portable": "npm run desktop:build && electron-builder --win portable --x64",
    "desktop:test": "npm test && npx tsc -p tsconfig.electron.json --noEmit",
    "validate:collections": "tsx scripts/validateCollections.ts default",
    "validate:collections:small": "tsx scripts/validateCollections.ts small",
    "validate:collections:medium": "tsx scripts/validateCollections.ts medium",
    "validate:collections:large": "tsx scripts/validateCollections.ts large",
    "validate:collections:integrity": "tsx scripts/validateCollections.ts integrity",
    "validate:collections:benchmark": "tsx scripts/validateCollections.ts benchmark",
    "validate:collections:memory-smoke": "tsx scripts/validateCollections.ts memory-smoke",
    "validate:collections:stress": "tsx scripts/validateCollectionsStress.ts stress",
    "validate:collections:soak:smoke": "tsx scripts/validateCollectionsStress.ts soak-smoke",
    "validate:collections:soak:30m": "tsx scripts/validateCollectionsStress.ts soak-30m",
    "validate:collections:soak:60m": "tsx scripts/validateCollectionsStress.ts soak-60m",
    "validate:collections:baseline-compare": "tsx scripts/validateCollectionsStress.ts baseline-compare",
    "validate:collections:ui-soak": "tsx scripts/uiSoak.ts",
    "validate:recovery:matrix": "tsx scripts/validateRecovery.ts matrix",
    "validate:recovery:durability": "tsx scripts/validateRecovery.ts durability",
    "validate:recovery:idempotency": "tsx scripts/validateRecovery.ts idempotency",
    "validate:recovery:consistency": "tsx scripts/validateRecovery.ts consistency",
    "validate:recovery:large": "tsx scripts/validateRecovery.ts large",
    "validate:recovery:browser-cycle": "tsx scripts/browserRecovery.ts cycle",
    "validate:recovery:browser-crash": "tsx scripts/browserRecovery.ts crash"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
