{
  "id": "adobestock",
  "label": "Adobe Stock",
  "future": false,
  "contributorUrl": "https://contributor.stock.adobe.com/",
  "contributorUrlVerified": true,
  "titleRules": { "minLength": 20, "maxLength": 70 },
  "descriptionRules": { "required": false, "minLength": 0, "maxLength": 0 },
  "keywordRules": { "minCount": 7, "maxCount": 49, "termLabel": "keywords" },
  "filenameRules": { "template": "{palette}-{category}-{layout}-seamless-pattern-{seed}", "maxLength": 100, "extension": "eps" },
  "defaultCategory": "Graphic Resources",
  "exportPackageFiles": ["pattern.svg", "preview.png", "title.txt", "keywords.txt", "filename.txt", "metadata.json"],
  "links": {
    "portal": { "url": "https://contributor.stock.adobe.com/", "verified": true },
    "submission": { "url": "https://contributor.stock.adobe.com/", "verified": true },
    "analytics": { "url": "https://contributor.stock.adobe.com/statistics", "verified": false },
    "help": { "url": "https://helpx.adobe.com/stock/contributor.html", "verified": false },
    "guidelines": { "url": "https://helpx.adobe.com/stock/contributor/help/submission-requirements.html", "verified": false },
    "support": { "url": "https://helpx.adobe.com/contact.html", "verified": false }
  },
  "collectionNamingRules": { "template": "{primaryKeyword} Collection", "maxLength": 70 },
  "supportedFileTypes": ["svg", "eps", "png", "jpg"],
  "previewRequirements": { "minWidth": 1000, "minHeight": 1000, "format": "jpg", "notes": "Conservative floor based on this app's own default preview export size; confirm against Adobe Stock's current contributor help docs for their exact published minimum/megapixel requirement." }
}
