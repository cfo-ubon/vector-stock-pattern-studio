{
  "id": "etsy",
  "label": "Etsy",
  "future": true,
  "contributorUrl": "https://www.etsy.com/sell",
  "contributorUrlVerified": false,
  "titleRules": { "minLength": 10, "maxLength": 140 },
  "descriptionRules": { "required": true, "minLength": 40, "maxLength": 5000, "practicalCeiling": true },
  "keywordRules": { "minCount": 5, "maxCount": 13, "maxKeywordLength": 20, "termLabel": "tags" },
  "filenameRules": { "template": "{palette}-{category}-{layout}-seamless-pattern-{seed}", "maxLength": 100, "extension": "svg" },
  "defaultCategory": "Digital Prints",
  "exportPackageFiles": ["pattern.svg", "preview.png", "title.txt", "description.txt", "keywords.txt", "filename.txt", "metadata.json"]
}
