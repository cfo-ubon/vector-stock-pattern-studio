{
  "id": "freepik",
  "label": "Freepik",
  "future": false,
  "contributorUrl": "https://www.freepik.com/contributor",
  "contributorUrlVerified": false,
  "titleRules": { "minLength": 20, "maxLength": 100 },
  "descriptionRules": { "required": false, "minLength": 0, "maxLength": 0 },
  "keywordRules": { "minCount": 7, "maxCount": 50, "termLabel": "keywords" },
  "filenameRules": { "template": "{palette}-{category}-{layout}-seamless-pattern-{seed}", "maxLength": 100, "extension": "eps" },
  "defaultCategory": "Vectors",
  "exportPackageFiles": ["pattern.svg", "preview.png", "title.txt", "keywords.txt", "filename.txt", "metadata.json"]
}
